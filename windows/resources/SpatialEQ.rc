#include <winres.h>
#include "../src/resource.h"

IDI_APP ICON "../../branding/icon/SpatialEQ.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SQ_VERSION_MAJOR,SQ_VERSION_MINOR,SQ_VERSION_PATCH,0
 PRODUCTVERSION SQ_VERSION_MAJOR,SQ_VERSION_MINOR,SQ_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Savannah DSP"
            VALUE "FileDescription", "SpatialEQ - system-wide EQ and spatial audio"
            VALUE "FileVersion", SQ_VERSION_STRING
            VALUE "InternalName", "SpatialEQ"
            VALUE "LegalCopyright", "Joel Kiptoo"
            VALUE "OriginalFilename", "SpatialEQ.exe"
            VALUE "ProductName", "SpatialEQ"
            VALUE "ProductVersion", SQ_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
