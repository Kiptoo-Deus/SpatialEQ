<?xml version="1.0" encoding="utf-8"?>
<!-- macOS Installer layout for the SpatialEQ plug-ins (VST3 + AU). VERSION is replaced by the build script. -->
<installer-gui-script minSpecVersion="2">
    <title>SpatialEQ Plug-ins</title>
    <organization>com.savannahdsp</organization>
    <background file="pkg-background.tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="pkg-background.tiff" alignment="bottomleft" scaling="none"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="Installs SpatialEQ.vst3 in /Library/Audio/Plug-Ins/VST3 (Cubase, Ableton Live, REAPER, Studio One, Bitwig...).">
        <pkg-ref id="com.savannahdsp.spatialeq.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Installs SpatialEQ.component in /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, MainStage...).">
        <pkg-ref id="com.savannahdsp.spatialeq.au"/>
    </choice>
    <pkg-ref id="com.savannahdsp.spatialeq.vst3" version="VERSION" onConclusion="none">SpatialEQ-vst3.pkg</pkg-ref>
    <pkg-ref id="com.savannahdsp.spatialeq.au" version="VERSION" onConclusion="none">SpatialEQ-au.pkg</pkg-ref>
</installer-gui-script>
